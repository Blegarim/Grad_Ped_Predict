# --- Datasets & large binaries ---
# Anchored to repo root so they don't also ignore the src/pedpredict/data/ package.
/PIE/
/data/
*.mp4
*.avi

# --- Virtual environments ---
venv/
.venv/
env/

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Model weights & serialized data ---
*.pt
*.pth
*.ckpt
*.pkl
*.lmdb
*.mdb
*.onnx
# ...but golden test fixtures (small, versioned characterization snapshots) MUST be tracked.
!tests/fixtures/golden/*.pt
!tests/fixtures/golden/*.pkl

# --- Generated LMDB datasets (writer output; content already covered by *.lmdb/*.mdb) ---
/preprocessed_*/
pose_cache/

# --- Run artifacts (per-run output dirs, logs, generated figures) ---
# Ignore everything under outputs/, but DO track the lightweight, portable text
# artifacts so runs can be compared/shared via git: index/train/eval CSV logs,
# resolved_config.yaml snapshots, thresholds/train_distribution JSON, and the
# hand-maintained markdown ledgers (RESULTS_MATRIX.md).
# Heavy checkpoints (*.pth, ignored above) and figures (*.png) stay out of git.
# The *.md exception was added 2026-08-18: RESULTS_MATRIX.md had been silently
# untracked since it was created, so the results ledger existed on ONE machine
# only — invisible to the lab PC that runs the evals it asks you to record.
outputs/**
!outputs/**/
!outputs/**/*.csv
!outputs/**/*.yaml
!outputs/**/*.json
!outputs/**/*.md
plots/*.png
*.xlsx
*.log

# --- Editor / tooling caches ---
.understand-anything/
.claude/settings.local.json
.ipynb_checkpoints/

# --- OS-specific ---
.DS_Store
Thumbs.db
